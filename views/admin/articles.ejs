<%- include('../partials/admin-header') %>

<div class="space-y-6">

  <!-- Status Filter Tabs -->
  <div class="flex items-center space-x-6 border-b border-tbf-border text-xs font-semibold text-gray-500">
    <button class="article-status-tab pb-3 border-b-2 border-tbf-navy font-bold text-tbf-navy" data-status="">
      All Articles
    </button>
    <button class="article-status-tab pb-3 hover:text-tbf-navy transition flex items-center gap-1.5" data-status="draft">
      <span>Drafts Awaiting Review</span>
      <span class="bg-amber-100 text-amber-800 text-[10px] px-1.5 py-0.2 font-bold">Gate</span>
    </button>
    <button class="article-status-tab pb-3 hover:text-tbf-navy transition" data-status="published">
      Live Published
    </button>
    <button class="article-status-tab pb-3 hover:text-tbf-navy transition" data-status="archived">
      Archived
    </button>
  </div>

  <!-- Search & Filter Controls -->
  <div class="bg-white p-4 border border-tbf-border flex flex-col md:flex-row items-center justify-between gap-4 text-xs">
    
    <div class="flex items-center gap-3 w-full md:w-auto flex-1">
      <input type="text" id="article-search-input" placeholder="Search by headline, deck, or tag..." class="w-full md:w-72 p-2.5 border border-tbf-border bg-[#FAFAF5] focus:outline-none focus:border-tbf-teal">
      
      <select id="article-category-filter" class="p-2.5 border border-tbf-border bg-[#FAFAF5] focus:outline-none focus:border-tbf-teal">
        <option value="">All Pillars</option>
        <% categories.forEach(cat => { %>
          <option value="<%= cat.slug %>"><%= cat.name %></option>
        <% }) %>
      </select>
    </div>

    <!-- Bulk Actions -->
    <div class="flex items-center gap-2 w-full md:w-auto justify-end">
      <select id="article-bulk-select" class="p-2.5 border border-tbf-border bg-[#FAFAF5]">
        <option value="">Bulk Actions...</option>
        <option value="publish">Publish Selected</option>
        <option value="archive">Archive Selected</option>
        <option value="delete">Delete Selected</option>
      </select>
      <button id="article-bulk-apply" class="tbf-btn-secondary py-2.5 px-4">Apply</button>
    </div>

  </div>

  <!-- Articles Table -->
  <div class="bg-white border border-tbf-border overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="bg-surface border-b border-tbf-border text-[10px] uppercase font-bold tracking-widest text-gray-500">
          <th class="p-4 w-8"><input type="checkbox" id="article-select-all"></th>
          <th class="p-4">Headline & Source</th>
          <th class="p-4">Pillar</th>
          <th class="p-4">Format</th>
          <th class="p-4">Status</th>
          <th class="p-4">Views</th>
          <th class="p-4">Date</th>
          <th class="p-4 text-right">Actions</th>
        </tr>
      </thead>
      <tbody id="articles-table-body" class="divide-y divide-tbf-border">
        <!-- Loaded dynamically via admin.js -->
      </tbody>
    </table>
  </div>

  <!-- Pagination Footnote -->
  <div class="flex items-center justify-between text-xs text-gray-500 pt-2" id="article-pagination-info">
    <span>Loading pagination...</span>
  </div>

</div>

<%- include('../partials/admin-footer') %>
