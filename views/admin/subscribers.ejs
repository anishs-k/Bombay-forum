<%- include('../partials/admin-header') %>

<div class="space-y-6 max-w-5xl">
  
  <div class="flex items-center justify-between pb-4 border-b border-tbf-border">
    <div>
      <h3 class="font-serif text-2xl font-bold text-tbf-navy">The Saturday Communiqué Subscribers</h3>
      <p class="text-xs text-gray-500 mt-1">Direct readership email list for weekly Saturday morning editorial dispatches.</p>
    </div>
    <a href="/api/subscribers/export" target="_blank" class="tbf-btn-secondary py-2.5 px-4 text-xs font-bold">
      ⬇ Export CSV
    </a>
  </div>

  <div class="bg-white border border-tbf-border overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="bg-surface border-b border-tbf-border text-[10px] uppercase font-bold tracking-widest text-gray-500">
          <th class="p-4">Subscriber Email</th>
          <th class="p-4">Name</th>
          <th class="p-4">Status</th>
          <th class="p-4">Subscribed Date</th>
        </tr>
      </thead>
      <tbody id="subscribers-table-body" class="divide-y divide-tbf-border">
        <!-- Populated via admin.js -->
      </tbody>
    </table>
  </div>

</div>

<%- include('../partials/admin-footer') %>
