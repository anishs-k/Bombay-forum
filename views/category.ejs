<%- include('partials/header') %>

<main class="flex-grow">

  <!-- Pillar Hero Banner -->
  <section class="bg-tbf-navy text-white py-12 md:py-16 border-b border-[#1A3347]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="tbf-category-badge text-tbf-sage text-xs tracking-widest block mb-2"><%= category.tagline %></span>
        <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-white mb-4">
          <%= category.name %>
        </h1>
        <p class="text-base sm:text-lg text-gray-300 font-sans leading-relaxed">
          <%= category.description %>
        </p>
      </div>

      <!-- Specific Pillar Indicators (e.g. Wealth Market Bar, Suite Subnav) -->
      <% if (category.slug === 'wealth') { %>
        <div class="mt-8 pt-6 border-t border-[#1A3347] flex flex-wrap items-center gap-6 text-xs text-tbf-sage">
          <span class="font-bold text-white uppercase tracking-wider">Market Indicators:</span>
          <div class="flex items-center gap-1.5"><span class="text-gray-400">SENSEX:</span> <strong class="text-emerald-400">83,420 (+0.78%)</strong></div>
          <div class="flex items-center gap-1.5"><span class="text-gray-400">NIFTY 50:</span> <strong class="text-emerald-400">25,410 (+0.82%)</strong></div>
          <div class="flex items-center gap-1.5"><span class="text-gray-400">USD/INR:</span> <strong class="text-gray-200">83.85</strong></div>
          <div class="flex items-center gap-1.5"><span class="text-gray-400">GOLD (10g):</span> <strong class="text-emerald-400">₹72,400</strong></div>
        </div>
      <% } else if (category.slug === 'suite') { %>
        <div class="mt-8 pt-6 border-t border-[#1A3347] flex flex-wrap gap-4 text-xs font-bold uppercase tracking-widest text-tbf-sage">
          <span class="text-white border-b-2 border-tbf-teal pb-1">All Curations</span>
          <span class="hover:text-white cursor-pointer transition">Hotels & Retreats</span>
          <span class="hover:text-white cursor-pointer transition">Horology & Watches</span>
          <span class="hover:text-white cursor-pointer transition">Architecture</span>
          <span class="hover:text-white cursor-pointer transition">Dining</span>
          <span class="hover:text-white cursor-pointer transition">Style</span>
        </div>
      <% } %>
    </div>
  </section>

  <!-- Lead Story & Secondary Grid -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    
    <% if (leadStory) { %>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 pb-16 border-b border-tbf-border">
        <!-- Lead Main -->
        <div class="lg:col-span-8 group">
          <a href="/article/<%= leadStory.slug %>" class="block overflow-hidden mb-5">
            <img src="<%= leadStory.heroImage %>" alt="<%= leadStory.title %>" class="w-full aspect-[16/9] object-cover group-hover:scale-105 transition duration-500">
          </a>
          <div class="space-y-3">
            <div class="flex items-center gap-3 text-xs text-gray-500">
              <span class="tbf-category-badge"><%= leadStory.format || 'feature' %></span>
              <span>•</span>
              <span><%= formatDate(leadStory.publishedAt || leadStory.createdAt) %></span>
              <span>•</span>
              <span><%= calculateReadingTime(leadStory.content) %></span>
            </div>
            <h2 class="font-serif text-3xl sm:text-4xl font-bold text-tbf-navy group-hover:text-tbf-teal transition leading-tight">
              <a href="/article/<%= leadStory.slug %>"><%= leadStory.title %></a>
            </h2>
            <p class="text-base text-gray-700 font-sans leading-relaxed">
              <%= leadStory.excerpt %>
            </p>
            <div class="pt-2 text-xs font-semibold text-gray-600">
              By <%= leadStory.author %>
            </div>
          </div>
        </div>

        <!-- Secondary Stories (Right 4 Cols) -->
        <div class="lg:col-span-4 space-y-6 lg:border-l lg:border-tbf-border lg:pl-8">
          <h3 class="font-serif text-base font-bold uppercase tracking-widest text-tbf-navy pb-2 border-b border-tbf-navy">Latest In <%= category.name %></h3>
          <% secondaryStories.forEach(art => { %>
            <article class="group pb-6 border-b border-tbf-border last:border-0">
              <div class="flex items-center gap-2 text-[10px] text-gray-500 mb-1">
                <span class="uppercase font-bold text-tbf-teal"><%= art.format || 'brief' %></span>
                <span>•</span>
                <span><%= calculateReadingTime(art.content) %></span>
              </div>
              <h4 class="font-serif text-lg font-bold text-tbf-navy group-hover:text-tbf-teal transition leading-snug">
                <a href="/article/<%= art.slug %>"><%= art.title %></a>
              </h4>
              <p class="text-xs text-gray-600 mt-1 line-clamp-2"><%= art.excerpt %></p>
            </article>
          <% }) %>
        </div>
      </div>
    <% } %>

    <!-- Profiles Hub (For Founders or Creators Pillar) -->
    <% if (profiles && profiles.length > 0) { %>
      <div class="py-16 border-b border-tbf-border">
        <div class="flex items-center justify-between pb-4 border-b border-tbf-navy mb-8">
          <div>
            <span class="tbf-category-badge text-xs">Flagship Profiles</span>
            <h3 class="font-serif text-2xl sm:text-3xl font-bold text-tbf-navy">
              <%= category.slug === 'founders' ? 'Founders Shaping India' : 'Creators & Cultural Pioneers' %>
            </h3>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <% profiles.forEach(prof => { %>
            <div class="bg-white border border-tbf-border p-6 flex flex-col justify-between group">
              <div>
                <a href="/<%= prof.type === 'founder' ? 'founder-profile' : 'creator-profile' %>/<%= prof.slug %>" class="block overflow-hidden mb-4">
                  <img src="<%= prof.heroImage %>" alt="<%= prof.name %>" class="w-full aspect-[4/5] object-cover <%= prof.type === 'founder' ? 'grayscale group-hover:grayscale-0' : '' %> transition duration-500">
                </a>
                <span class="text-[10px] font-bold uppercase tracking-widest text-tbf-teal"><%= prof.company || prof.medium %></span>
                <h4 class="font-serif text-2xl font-bold text-tbf-navy mt-1 group-hover:text-tbf-teal transition">
                  <a href="/<%= prof.type === 'founder' ? 'founder-profile' : 'creator-profile' %>/<%= prof.slug %>"><%= prof.name %></a>
                </h4>
                <p class="font-serif italic text-xs text-gray-600 mt-3 line-clamp-3">
                  "<%= prof.quote %>"
                </p>
              </div>
              <div class="pt-4 mt-4 border-t border-tbf-border flex items-center justify-between text-xs">
                <span class="text-gray-500"><%= prof.location %></span>
                <a href="/<%= prof.type === 'founder' ? 'founder-profile' : 'creator-profile' %>/<%= prof.slug %>" class="font-bold text-tbf-teal hover:underline">Read Profile →</a>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>

    <!-- Remaining Stories Grid -->
    <% if (remainingStories && remainingStories.length > 0) { %>
      <div class="pt-16">
        <h3 class="font-serif text-2xl font-bold text-tbf-navy mb-8 pb-3 border-b border-tbf-navy">Archive & Dispatches</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <% remainingStories.forEach(art => { %>
            <article class="bg-white border border-tbf-border p-6 flex flex-col justify-between group">
              <div>
                <div class="flex items-center gap-2 text-[10px] text-gray-500 mb-2">
                  <span class="uppercase font-bold text-tbf-teal"><%= art.format || 'brief' %></span>
                  <span>•</span>
                  <span><%= formatDate(art.publishedAt || art.createdAt, 'short') %></span>
                </div>
                <h4 class="font-serif text-xl font-bold text-tbf-navy leading-snug group-hover:text-tbf-teal transition">
                  <a href="/article/<%= art.slug %>"><%= art.title %></a>
                </h4>
                <p class="text-xs text-gray-600 mt-2 line-clamp-3"><%= art.excerpt %></p>
              </div>
              <div class="pt-4 mt-4 border-t border-gray-100 flex justify-between items-center text-xs text-gray-500">
                <span><%= art.author %></span>
                <a href="/article/<%= art.slug %>" class="text-tbf-teal font-bold hover:underline">Read →</a>
              </div>
            </article>
          <% }) %>
        </div>
      </div>
    <% } %>

  </section>

</main>

<%- include('partials/footer') %>
