  <!-- Main Footer -->
  <footer class="bg-tbf-navy text-[#FAFAF5] mt-auto border-t border-[#1A3347] pt-16 pb-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 pb-12 border-b border-[#1A3347]">
        
        <!-- Brand Manifesto Column -->
        <div class="md:col-span-5 space-y-4">
          <a href="/" class="text-2xl font-serif font-bold tracking-tight text-[#FAFAF5] block">
            THE BOMBAY FORUM
          </a>
          <p class="text-xs uppercase tracking-[0.2em] text-tbf-sage font-semibold">
            Business · Wealth · Luxury · Culture
          </p>
          <p class="text-sm text-gray-300 font-sans leading-relaxed max-w-md pt-2">
            The Bombay Forum is a premium editorial platform chronicling the capital, vision, and cultural energy building modern India. High-conviction reporting, authoritative analysis, and perspective over noise.
          </p>
          <div class="pt-2 text-xs text-tbf-sage">
            <span>Published from Mumbai, India</span>
          </div>
        </div>

        <!-- The Six Pillars Links -->
        <div class="md:col-span-4 grid grid-cols-2 gap-6">
          <div>
            <h4 class="text-xs uppercase font-bold tracking-widest text-tbf-sage mb-4">Editorial Pillars</h4>
            <ul class="space-y-2.5 text-xs font-medium">
              <% categories.forEach(cat => { %>
                <li>
                  <a href="<%= cat.path %>" class="text-gray-300 hover:text-white hover:underline transition">
                    <%= cat.name %>
                  </a>
                </li>
              <% }) %>
            </ul>
          </div>
          <div>
            <h4 class="text-xs uppercase font-bold tracking-widest text-tbf-sage mb-4">Franchises & IP</h4>
            <ul class="space-y-2.5 text-xs font-medium text-gray-300">
              <li><a href="/wealth" class="hover:text-white transition">Market Pulse</a></li>
              <li><a href="/future" class="hover:text-white transition">Signal vs Noise</a></li>
              <li><a href="/founders" class="hover:text-white transition">Ones to Watch</a></li>
              <li><a href="/bombay" class="hover:text-white transition">Bombay This Week</a></li>
              <li><a href="/suite" class="hover:text-white transition">The Suite Edit</a></li>
              <li><a href="/creators" class="hover:text-white transition">Creator Economy</a></li>
            </ul>
          </div>
        </div>

        <!-- Saturday Communiqué Newsletter Column -->
        <div class="md:col-span-3 space-y-4" id="newsletter-signup">
          <h4 class="text-xs uppercase font-bold tracking-widest text-tbf-sage">The Saturday Communiqué</h4>
          <p class="text-xs text-gray-300 leading-normal">
            Our curated weekly dispatch delivered every Saturday morning. The essential stories, market perspective, and cultural notes.
          </p>
          <form class="tbf-newsletter-form space-y-2">
            <input type="email" name="email" required placeholder="Enter your email" class="w-full bg-[#081724] border border-[#1A3347] p-2.5 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-tbf-teal">
            <button type="submit" class="w-full tbf-btn-teal text-xs py-2.5">
              Subscribe Free
            </button>
          </form>
          <p class="text-[10px] text-gray-400">Strictly editorial. Zero spam. Unsubscribe anytime.</p>
        </div>

      </div>

      <!-- Bottom Legal & Meta Bar -->
      <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-gray-400 gap-4">
        <div>
          © <%= new Date().getFullYear() %> The Bombay Forum. All rights reserved. Prepared for MJX Labs.
        </div>
        <div class="flex items-center space-x-6">
          <a href="/about" class="hover:text-white transition">About & Masthead</a>
          <a href="/spotlight" class="hover:text-white transition">Spotlight / Advertising</a>
          <a href="/policies" class="hover:text-white transition">Ethics & Privacy</a>
          <a href="/rss" class="hover:text-white transition flex items-center gap-1 text-tbf-teal-light">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M6.18 15.64a2.18 2.18 0 1 0 2.18 2.18 2.18 2.18 0 0 0-2.18-2.18zm-2.18-8.14v3.27a7.05 7.05 0 0 1 7.05 7.05h3.27a10.32 10.32 0 0 0-10.32-10.32zm0-5.5v3.27a12.55 12.55 0 0 1 12.55 12.55h3.27a15.82 15.82 0 0 0-15.82-15.82z"/></svg>
            RSS Feed
          </a>
          <a href="/sitemap.xml" class="hover:text-white transition">Sitemap</a>
        </div>
      </div>

    </div>
  </footer>

  <!-- Scripts -->
  <script src="/js/main.js"></script>
</body>
</html>
