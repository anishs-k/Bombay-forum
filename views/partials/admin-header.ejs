<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle || 'Editorial Desk — TBF Admin' %></title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'tbf-navy': '#0E2130',
            'tbf-sidebar': '#091C2A',
            'tbf-teal': '#4A8090',
            'tbf-teal-light': '#8BB0B8',
            'tbf-sage': '#B8D4CC',
            'tbf-cream': '#FAFAF5',
            'tbf-surface': '#EEEEE9',
            'tbf-border': '#D6D6CF',
          }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-[#F4F4F0] text-[#121A20] font-sans antialiased">

<div class="flex h-screen overflow-hidden">

  <!-- Admin Sidebar (#091C2A) -->
  <aside class="w-64 bg-tbf-sidebar text-white flex flex-col justify-between flex-shrink-0 border-r border-[#1A3347]">
    <div>
      <!-- Brand Header -->
      <div class="p-6 border-b border-[#1A3347]">
        <a href="/admin/dashboard" class="font-serif text-lg font-bold tracking-tight text-white block">
          THE BOMBAY FORUM
        </a>
        <div class="flex items-center gap-2 mt-1">
          <span class="inline-block w-2 h-2 bg-emerald-400"></span>
          <span class="text-[10px] tracking-widest uppercase text-tbf-sage font-bold">Editorial Desk v1.1</span>
        </div>
      </div>

      <!-- Navigation Links -->
      <nav class="p-4 space-y-1 text-xs font-semibold tracking-wide">
        <a href="/admin/dashboard" class="flex items-center gap-3 px-3 py-2.5 transition <%= currentPath === '/admin/dashboard' ? 'bg-[#152E42] text-white border-l-2 border-tbf-teal font-bold' : 'text-gray-300 hover:bg-[#112433] hover:text-white' %>">
          <svg class="w-4 h-4 text-tbf-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
          Dashboard
        </a>

        <a href="/admin/articles" class="flex items-center gap-3 px-3 py-2.5 transition <%= currentPath === '/admin/articles' ? 'bg-[#152E42] text-white border-l-2 border-tbf-teal font-bold' : 'text-gray-300 hover:bg-[#112433] hover:text-white' %>">
          <svg class="w-4 h-4 text-tbf-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path></svg>
          Articles
        </a>

        <a href="/admin/editor" class="flex items-center gap-3 px-3 py-2.5 transition <%= currentPath === '/admin/editor' ? 'bg-[#152E42] text-white border-l-2 border-tbf-teal font-bold' : 'text-gray-300 hover:bg-[#112433] hover:text-white' %>">
          <svg class="w-4 h-4 text-tbf-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
          New Article
        </a>

        <a href="/admin/profiles" class="flex items-center gap-3 px-3 py-2.5 transition <%= currentPath === '/admin/profiles' || currentPath.includes('/admin/profile-editor') ? 'bg-[#152E42] text-white border-l-2 border-tbf-teal font-bold' : 'text-gray-300 hover:bg-[#112433] hover:text-white' %>">
          <svg class="w-4 h-4 text-tbf-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
          Founders & Creators
        </a>

        <a href="/admin/homepage" class="flex items-center gap-3 px-3 py-2.5 transition <%= currentPath === '/admin/homepage' ? 'bg-[#152E42] text-white border-l-2 border-tbf-teal font-bold' : 'text-gray-300 hover:bg-[#112433] hover:text-white' %>">
          <svg class="w-4 h-4 text-tbf-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
          Homepage Controller
        </a>

        <a href="/admin/ingestion" class="flex items-center gap-3 px-3 py-2.5 transition <%= currentPath === '/admin/ingestion' ? 'bg-[#152E42] text-white border-l-2 border-tbf-teal font-bold' : 'text-gray-300 hover:bg-[#112433] hover:text-white' %>">
          <svg class="w-4 h-4 text-tbf-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          Ingestion & Sources
        </a>

        <a href="/admin/subscribers" class="flex items-center gap-3 px-3 py-2.5 transition <%= currentPath === '/admin/subscribers' ? 'bg-[#152E42] text-white border-l-2 border-tbf-teal font-bold' : 'text-gray-300 hover:bg-[#112433] hover:text-white' %>">
          <svg class="w-4 h-4 text-tbf-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
          Newsletter Queue
        </a>

        <a href="/admin/spotlights" class="flex items-center gap-3 px-3 py-2.5 transition <%= currentPath === '/admin/spotlights' ? 'bg-[#152E42] text-white border-l-2 border-tbf-teal font-bold' : 'text-gray-300 hover:bg-[#112433] hover:text-white' %>">
          <svg class="w-4 h-4 text-tbf-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path></svg>
          Spotlight Leads
        </a>

        <a href="/admin/seo" class="flex items-center gap-3 px-3 py-2.5 transition <%= currentPath === '/admin/seo' ? 'bg-[#152E42] text-white border-l-2 border-tbf-teal font-bold' : 'text-gray-300 hover:bg-[#112433] hover:text-white' %>">
          <svg class="w-4 h-4 text-tbf-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
          SEO & Distribution
        </a>
      </nav>
    </div>

    <!-- Bottom Account & Live Site -->
    <div class="p-4 border-t border-[#1A3347] space-y-2">
      <a href="/" target="_blank" class="flex items-center justify-between text-xs text-tbf-sage hover:text-white px-3 py-2 bg-[#0B1A26]">
        <span>View Live Site</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
      </a>
      <button id="admin-logout-btn" class="w-full text-left text-xs text-rose-300 hover:text-rose-100 px-3 py-2 transition flex items-center justify-between">
        <span>Sign Out</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
      </button>
    </div>
  </aside>

  <!-- Main Content Wrapper -->
  <main class="flex-1 flex flex-col overflow-y-auto bg-[#FAFAF5]">
    
    <!-- Admin Top Navbar -->
    <header class="bg-white border-b border-tbf-border px-8 py-4 flex items-center justify-between sticky top-0 z-30">
      <div class="flex items-center gap-4">
        <h1 class="font-serif text-xl font-bold text-tbf-navy"><%= pageTitle %></h1>
      </div>
      <div class="flex items-center gap-4 text-xs">
        <span class="text-gray-500">Logged in as <strong class="text-tbf-navy"><%= typeof currentUser !== 'undefined' && currentUser ? currentUser.name : 'Editor-in-Chief' %></strong></span>
        <a href="/admin/editor" class="tbf-btn-primary py-2 px-4 text-xs">+ Create Article</a>
      </div>
    </header>

    <!-- Page Content Container -->
    <div class="p-8">
