<%- include('partials/header') %>

<main class="flex-grow">

  <!-- 1. Top Section: Cover Story & Editor's Picks (Brief 8.1) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
      
      <!-- Cover Story Hero (Left 7 Cols) -->
      <% if (coverStory) { %>
        <div class="lg:col-span-7 flex flex-col justify-between">
          <div class="group">
            <a href="/article/<%= coverStory.slug %>" class="block overflow-hidden mb-5">
              <img src="<%= coverStory.heroImage %>" alt="<%= coverStory.title %>" class="w-full aspect-[16/9] object-cover transition duration-500 group-hover:scale-[1.02]">
            </a>
            <div class="space-y-3">
              <div class="flex items-center gap-3">
                <a href="/<%= coverStory.category %>" class="tbf-category-badge"><%= coverStory.category %></a>
                <span class="text-xs text-gray-400">•</span>
                <span class="text-xs text-gray-500 font-sans"><%= formatDate(coverStory.publishedAt || coverStory.createdAt) %></span>
                <span class="text-xs text-gray-400">•</span>
                <span class="text-xs text-gray-500 font-sans"><%= calculateReadingTime(coverStory.content) %></span>
              </div>
              <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-tbf-navy leading-[1.15] tracking-tight hover:text-tbf-teal transition">
                <a href="/article/<%= coverStory.slug %>"><%= coverStory.title %></a>
              </h2>
              <p class="text-base sm:text-lg text-gray-700 font-sans leading-relaxed pt-1">
                <%= coverStory.excerpt %>
              </p>
              <div class="pt-2 flex items-center gap-2 text-xs font-semibold text-gray-600">
                <span>By <%= coverStory.author || 'TBF Editorial Desk' %></span>
              </div>
            </div>
          </div>
        </div>
      <% } %>

      <!-- Editor's Picks (Right 5 Cols) -->
      <div class="lg:col-span-5 flex flex-col justify-between space-y-6 lg:border-l lg:border-tbf-border lg:pl-10">
        <div>
          <div class="flex items-center justify-between pb-3 border-b-2 border-tbf-navy mb-6">
            <h3 class="font-serif text-lg font-bold uppercase tracking-wider text-tbf-navy">Editor’s Picks</h3>
            <span class="text-[10px] uppercase font-bold tracking-widest text-tbf-teal">Curated</span>
          </div>

          <div class="space-y-6">
            <% editorsPicks.forEach((art, idx) => { %>
              <article class="group pb-6 <%= idx < editorsPicks.length - 1 ? 'border-b border-tbf-border' : '' %>">
                <div class="flex items-center gap-2 mb-1.5">
                  <a href="/<%= art.category %>" class="tbf-category-badge text-[9px]"><%= art.category %></a>
                  <span class="text-[10px] text-gray-400">•</span>
                  <span class="text-[10px] text-gray-500"><%= calculateReadingTime(art.content) %></span>
                </div>
                <h4 class="font-serif text-xl font-bold text-tbf-navy leading-snug group-hover:text-tbf-teal transition">
                  <a href="/article/<%= art.slug %>"><%= art.title %></a>
                </h4>
                <p class="text-xs text-gray-600 font-sans mt-2 line-clamp-2 leading-relaxed">
                  <%= art.excerpt %>
                </p>
              </article>
            <% }) %>
          </div>
        </div>

        <!-- Mini Communiqué Card -->
        <div class="bg-tbf-surface p-5 border-l-2 border-tbf-teal">
          <span class="text-[9px] uppercase font-bold tracking-widest text-tbf-teal block mb-1">Newsletter</span>
          <h4 class="font-serif text-base font-bold text-tbf-navy">The Saturday Communiqué</h4>
          <p class="text-xs text-gray-600 mt-1 mb-3">The essential editorial digest for people building modern India.</p>
          <form class="tbf-newsletter-form flex gap-2">
            <input type="email" name="email" required placeholder="Your email address" class="flex-1 bg-white border border-tbf-border p-2 text-xs focus:outline-none focus:border-tbf-teal">
            <button type="submit" class="tbf-btn-primary py-2 px-3 text-xs">Join</button>
          </form>
        </div>

      </div>

    </div>
  </section>

  <!-- 2. Sponsored Strip (Configurable via Admin Homepage Controller: Brief 6.3 & 10) -->
  <% if (sponsoredStrip && sponsoredStrip.enabled) { %>
    <section class="bg-[#F0F4F2] border-y border-[#D6E2DD] py-3.5 px-4">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2 text-xs">
        <div class="flex items-center gap-3">
          <span class="bg-tbf-teal text-white font-bold uppercase tracking-wider text-[9px] px-2 py-0.5"><%= sponsoredStrip.label || 'Partner Dispatch' %></span>
          <span class="font-serif font-bold text-tbf-navy"><%= sponsoredStrip.sponsorName %></span>
          <span class="text-gray-700 hidden md:inline">— <%= sponsoredStrip.text %></span>
        </div>
        <a href="<%= sponsoredStrip.linkUrl || '/spotlight' %>" class="text-xs font-bold text-tbf-teal hover:underline tracking-wide uppercase">
          Explore Feature →
        </a>
      </div>
    </section>
  <% } %>

  <!-- 3. Featured This Week Section (Surface Background Shift) -->
  <section class="bg-tbf-surface py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex items-center justify-between pb-4 border-b border-tbf-border mb-8">
        <div>
          <span class="tbf-category-badge text-xs">Analysis & Deep Dives</span>
          <h3 class="font-serif text-2xl sm:text-3xl font-bold text-tbf-navy mt-1">Featured This Week</h3>
        </div>
        <a href="/founders" class="text-xs uppercase font-bold tracking-widest text-tbf-teal hover:underline">View All Stories →</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <% featuredThisWeek.forEach(art => { %>
          <article class="bg-white border border-tbf-border flex flex-col justify-between group">
            <div>
              <a href="/article/<%= art.slug %>" class="block overflow-hidden">
                <img src="<%= art.heroImage %>" alt="<%= art.title %>" class="w-full aspect-[16/10] object-cover transition duration-300 group-hover:scale-105">
              </a>
              <div class="p-6">
                <div class="flex items-center gap-2 mb-2">
                  <a href="/<%= art.category %>" class="tbf-category-badge text-[10px]"><%= art.category %></a>
                  <span class="text-xs text-gray-400">•</span>
                  <span class="text-xs text-gray-500 font-sans"><%= calculateReadingTime(art.content) %></span>
                </div>
                <h4 class="font-serif text-xl font-bold text-tbf-navy leading-snug group-hover:text-tbf-teal transition mb-3">
                  <a href="/article/<%= art.slug %>"><%= art.title %></a>
                </h4>
                <p class="text-xs text-gray-600 font-sans leading-relaxed line-clamp-3">
                  <%= art.excerpt %>
                </p>
              </div>
            </div>
            <div class="px-6 pb-6 pt-2 border-t border-gray-100 flex items-center justify-between text-xs text-gray-500">
              <span><%= art.author || 'TBF Editorial' %></span>
              <span><%= formatDate(art.publishedAt || art.createdAt, 'short') %></span>
            </div>
          </article>
        <% }) %>
      </div>

    </div>
  </section>

  <!-- 4. Pillar Highlights: The Founders & Creators (Split Feature) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
      
      <!-- The Founders Pillar -->
      <div class="space-y-6">
        <div class="flex items-center justify-between pb-3 border-b-2 border-tbf-navy">
          <div>
            <span class="tbf-category-badge">Pillar 01</span>
            <h3 class="font-serif text-2xl font-bold text-tbf-navy">The Founders</h3>
          </div>
          <a href="/founders" class="text-xs uppercase font-bold tracking-widest text-tbf-teal hover:underline">Explore Founders →</a>
        </div>

        <% if (categoryArticles['founders'] && categoryArticles['founders'].length > 0) { %>
          <% const leadF = categoryArticles['founders'][0]; %>
          <div class="group">
            <a href="/article/<%= leadF.slug %>" class="block overflow-hidden mb-4">
              <img src="<%= leadF.heroImage %>" alt="<%= leadF.title %>" class="w-full aspect-[16/9] object-cover group-hover:scale-105 transition">
            </a>
            <h4 class="font-serif text-2xl font-bold text-tbf-navy hover:text-tbf-teal transition">
              <a href="/article/<%= leadF.slug %>"><%= leadF.title %></a>
            </h4>
            <p class="text-xs sm:text-sm text-gray-600 mt-2 line-clamp-2"><%= leadF.excerpt %></p>
          </div>

          <div class="space-y-4 pt-4 border-t border-tbf-border">
            <% categoryArticles['founders'].slice(1, 3).forEach(art => { %>
              <div class="flex gap-4 items-start group">
                <img src="<%= art.heroImage %>" class="w-20 h-16 object-cover flex-shrink-0" alt="<%= art.title %>">
                <div>
                  <h5 class="font-serif text-sm font-bold text-tbf-navy group-hover:text-tbf-teal transition">
                    <a href="/article/<%= art.slug %>"><%= art.title %></a>
                  </h5>
                  <span class="text-[10px] text-gray-500 mt-1 block"><%= formatDate(art.publishedAt || art.createdAt, 'short') %></span>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>

      <!-- Creators Pillar -->
      <div class="space-y-6">
        <div class="flex items-center justify-between pb-3 border-b-2 border-tbf-navy">
          <div>
            <span class="tbf-category-badge">Pillar 02</span>
            <h3 class="font-serif text-2xl font-bold text-tbf-navy">Creators</h3>
          </div>
          <a href="/creators" class="text-xs uppercase font-bold tracking-widest text-tbf-teal hover:underline">Explore Creators →</a>
        </div>

        <% if (categoryArticles['creators'] && categoryArticles['creators'].length > 0) { %>
          <% const leadC = categoryArticles['creators'][0]; %>
          <div class="group">
            <a href="/article/<%= leadC.slug %>" class="block overflow-hidden mb-4">
              <img src="<%= leadC.heroImage %>" alt="<%= leadC.title %>" class="w-full aspect-[16/9] object-cover group-hover:scale-105 transition">
            </a>
            <h4 class="font-serif text-2xl font-bold text-tbf-navy hover:text-tbf-teal transition">
              <a href="/article/<%= leadC.slug %>"><%= leadC.title %></a>
            </h4>
            <p class="text-xs sm:text-sm text-gray-600 mt-2 line-clamp-2"><%= leadC.excerpt %></p>
          </div>

          <div class="space-y-4 pt-4 border-t border-tbf-border">
            <% categoryArticles['creators'].slice(1, 3).forEach(art => { %>
              <div class="flex gap-4 items-start group">
                <img src="<%= art.heroImage %>" class="w-20 h-16 object-cover flex-shrink-0" alt="<%= art.title %>">
                <div>
                  <h5 class="font-serif text-sm font-bold text-tbf-navy group-hover:text-tbf-teal transition">
                    <a href="/article/<%= art.slug %>"><%= art.title %></a>
                  </h5>
                  <span class="text-[10px] text-gray-500 mt-1 block"><%= formatDate(art.publishedAt || art.createdAt, 'short') %></span>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>

    </div>
  </section>

  <!-- 5. Dark Section: The Suite & Wealth (Navy Background Shift) -->
  <section class="bg-tbf-navy text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex items-center justify-between pb-4 border-b border-[#1A3347] mb-10">
        <div>
          <span class="text-xs uppercase font-bold tracking-widest text-tbf-sage">The Suite & Luxury</span>
          <h3 class="font-serif text-3xl font-bold text-white mt-1">Exceptional Living & Private Wealth</h3>
        </div>
        <a href="/suite" class="text-xs uppercase font-bold tracking-widest text-tbf-teal-light hover:underline">The Suite Hub →</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <% if (categoryArticles['suite']) { %>
          <% categoryArticles['suite'].slice(0, 3).forEach(art => { %>
            <article class="bg-[#0B1A26] border border-[#1A3347] p-6 flex flex-col justify-between group">
              <div>
                <a href="/article/<%= art.slug %>" class="block overflow-hidden mb-4">
                  <img src="<%= art.heroImage %>" alt="<%= art.title %>" class="w-full aspect-[16/10] object-cover group-hover:scale-105 transition">
                </a>
                <span class="tbf-category-badge text-[9px] text-tbf-teal-light">The Suite Edit</span>
                <h4 class="font-serif text-xl font-bold text-white mt-2 leading-snug group-hover:text-tbf-sage transition">
                  <a href="/article/<%= art.slug %>"><%= art.title %></a>
                </h4>
                <p class="text-xs text-gray-300 font-sans mt-3 line-clamp-3 leading-relaxed">
                  <%= art.excerpt %>
                </p>
              </div>
              <div class="pt-4 mt-4 border-t border-[#1A3347] flex justify-between items-center text-xs text-tbf-sage">
                <span><%= art.author %></span>
                <span><%= calculateReadingTime(art.content) %></span>
              </div>
            </article>
          <% }) %>
        <% } %>
      </div>

    </div>
  </section>

  <!-- 6. Bombay & Future Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- Bombay Section (7 Cols) -->
      <div class="lg:col-span-7 space-y-6">
        <div class="flex items-center justify-between pb-3 border-b-2 border-tbf-navy">
          <div>
            <span class="tbf-category-badge">Identity Anchor</span>
            <h3 class="font-serif text-2xl font-bold text-tbf-navy">Bombay: The Soul of Maximum City</h3>
          </div>
          <a href="/bombay" class="text-xs uppercase font-bold tracking-widest text-tbf-teal hover:underline">City Desk →</a>
        </div>

        <% if (categoryArticles['bombay'] && categoryArticles['bombay'].length > 0) { %>
          <% const bmb = categoryArticles['bombay'][0]; %>
          <div class="group">
            <a href="/article/<%= bmb.slug %>" class="block overflow-hidden mb-4">
              <img src="<%= bmb.heroImage %>" alt="<%= bmb.title %>" class="w-full aspect-[16/9] object-cover group-hover:scale-105 transition">
            </a>
            <h4 class="font-serif text-2xl font-bold text-tbf-navy hover:text-tbf-teal transition">
              <a href="/article/<%= bmb.slug %>"><%= bmb.title %></a>
            </h4>
            <p class="text-sm text-gray-600 mt-2"><%= bmb.excerpt %></p>
          </div>
        <% } %>
      </div>

      <!-- Future & Signal vs Noise (5 Cols) -->
      <div class="lg:col-span-5 space-y-6">
        <div class="flex items-center justify-between pb-3 border-b-2 border-tbf-navy">
          <div>
            <span class="tbf-category-badge">Pillar 04</span>
            <h3 class="font-serif text-2xl font-bold text-tbf-navy">Future & AI</h3>
          </div>
          <a href="/future" class="text-xs uppercase font-bold tracking-widest text-tbf-teal hover:underline">Future Hub →</a>
        </div>

        <div class="space-y-6">
          <% if (categoryArticles['future']) { %>
            <% categoryArticles['future'].slice(0, 3).forEach(art => { %>
              <article class="group pb-4 border-b border-tbf-border">
                <span class="text-[9px] uppercase font-bold tracking-widest text-tbf-teal">Signal vs Noise</span>
                <h4 class="font-serif text-lg font-bold text-tbf-navy group-hover:text-tbf-teal transition mt-1">
                  <a href="/article/<%= art.slug %>"><%= art.title %></a>
                </h4>
                <p class="text-xs text-gray-600 mt-1 line-clamp-2"><%= art.excerpt %></p>
              </article>
            <% }) %>
          <% } %>
        </div>
      </div>

    </div>
  </section>

</main>

<%- include('partials/footer') %>
